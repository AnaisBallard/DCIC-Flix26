# Local-only credentials. Change these before using any shared environment.
MONGO_INITDB_ROOT_USERNAME=flix
MONGO_INITDB_ROOT_PASSWORD=flix_local_dev_only
MONGODB_DATABASE=peliculas-proyectos
MONGODB_CATALOG_USER=flix_catalog
MONGODB_CATALOG_PASSWORD=catalog_local_dev
MONGODB_RECOMMENDATION_USER=flix_recommendation
MONGODB_RECOMMENDATION_PASSWORD=recommendation_local_dev
MONGODB_CONSUMER_USER=flix_consumer
MONGODB_CONSUMER_PASSWORD=consumer_local_dev
MONGODB_CLEANER_USER=flix_cleaner
MONGODB_CLEANER_PASSWORD=cleaner_local_dev

RABBITMQ_DEFAULT_USER=flix
RABBITMQ_DEFAULT_PASS=flix_local_dev_only

# Required to infer missing or invalid review ratings during cleaning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CLEANER_VERSION=1
RECOMMENDER_VERSION=1
